# BMUX configuration file
# Copy to ~/.config/bmux/config.toml (or $XDG_CONFIG_HOME/bmux/config.toml).
# Every field is optional. Unset fields use the defaults shown here.
# Apply changes to a running session with `bmux config reload` or `Ctrl-b r`.

# ── Terminal UI ────────────────────────────────────────────────────────────
[tui]
# Prefix key: ctrl-<letter>, e.g. "ctrl-a" for screen-style bindings.
prefix_key = "ctrl-b"
# Shell for new panes. Default: $SHELL, then /bin/sh.
# default_shell = "/bin/zsh"
# Show the status bar (session, windows, agents and their estimated cost).
status_bar = true

# ── Agents ─────────────────────────────────────────────────────────────────
[agents]
# Type used by `bmux agent spawn --name <name>` when no type is given.
# claude-code (alias: claude), opencode, pi, gemini, shell, or a custom name.
default_type = "claude-code"

[agents.claude_code]
binary = "claude"

[agents.opencode]
binary = "opencode"

[agents.pi]
binary = "pi"

# Custom agent: `bmux agent spawn my-agent --name x`
# [agents.my-agent]
# binary = "my-agent-cli"
# model = "llama-3.1-70b"
# cost_per_1k_tokens = 0.0001
# args = ["--mode", "interactive"]

# ── Security ───────────────────────────────────────────────────────────────
[security]
# Filesystem sandbox for agents: landlock | namespace | seatbelt | none
sandbox = "landlock"
# Opt-in only. Not recommended.
allow_dangerous_permissions = false

# ── Audit ──────────────────────────────────────────────────────────────────
[audit]
enabled = true
